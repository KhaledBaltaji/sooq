name: Env Var Parity

on:
  pull_request:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: env-parity-${{ github.ref }}
  cancel-in-progress: true

jobs:
  parity:
    name: Vercel Env Parity
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm
      - run: npm ci
      - run: npx tsx scripts/check-env-parity.ts
        env:
          VERCEL_TOKEN: ${{ secrets.VERCEL_TOKEN }}
          VERCEL_PROJECT_ID: prj_qCPstRDdAoRFJ5b4JVVTtk3fMefd
          VERCEL_ORG_ID: team_upNpHo6VzPFNq4sx4zi4S0PB
