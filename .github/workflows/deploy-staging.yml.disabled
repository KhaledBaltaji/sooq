name: Deploy Staging

# Architecture (post-flip 2026-04-27):
#
#   1. type-check          fast (~30s) — catches dumb bugs before we touch the DB
#   2. migrate             apply migrations to staging (idempotent)
#   3. smoke-test          run money-path tests AGAINST the just-migrated schema
#   4. health-check        Vercel + /api/health
#
# Why migrate-before-test: every code change ships paired with a migration.
# Running tests against the OLD schema (pre-migration) means tests written
# for the new schema fail with timeouts and shape mismatches — the exact
# trap that took down the last 5 deploys plus the one we cancelled at 24m.
#
# Smoke set is the irreducible "money path": trade execution, resolution,
# commissions, payout invariants, deposits/withdrawals. ~3-4 min total.
# The other 30+ test files (admin tooling, demo mode, branch lifecycle,
# concurrency stress) run nightly via .github/workflows/nightly-full-test.yml
# and on every PR to main via deploy-production.yml — so coverage is intact,
# just at the right cadence for each gate.

on:
  push:
    branches: [staging]

concurrency:
  group: deploy-staging
  cancel-in-progress: false

jobs:
  type-check:
    name: Type Check
    runs-on: ubuntu-latest
    environment: staging
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm
      - run: npm ci
      - name: Type check
        run: npx tsc --noEmit

  migrate:
    name: Apply Migrations
    needs: type-check
    runs-on: ubuntu-latest
    environment: staging
    steps:
      - uses: actions/checkout@v4

      - uses: supabase/setup-cli@v2
        with:
          version: latest

      - name: Link Supabase project
        run: supabase link --project-ref ${{ secrets.SUPABASE_PROJECT_REF }}
        env:
          SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN }}

      - name: Push migrations
        # --include-all picks up out-of-order migrations (parallel sessions
        # may reserve numbers non-sequentially). Safe because every migration
        # is idempotent (CREATE OR REPLACE / IF NOT EXISTS / ON CONFLICT).
        # SUPABASE_DB_PASSWORD required — without it the CLI access-token
        # bootstrap times out at the Supabase side.
        run: supabase db push --include-all
        env:
          SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN }}
          SUPABASE_DB_PASSWORD: ${{ secrets.SUPABASE_DB_PASSWORD }}

      - name: Verify schema matches snapshot
        # Soft check: warns on drift but does NOT block the deploy. Snapshot
        # regeneration is operator-driven (`supabase db dump --linked …`) and
        # tends to lag a migration or two; blocking on it makes the deploy
        # pipeline flap on legitimate schema additions. Nightly full-test
        # workflow can be extended to enforce hard drift if needed.
        run: |
          LINES=$(wc -l < supabase/schema.sql)
          if [ "$LINES" -lt 50 ]; then
            echo "::warning::supabase/schema.sql is a placeholder stub ($LINES lines) — drift gate skipped."
            exit 0
          fi
          supabase db diff --linked --schema public > /tmp/drift.sql || true
          # Filter date-partitioned speed_* tables (auto-created on schedule).
          grep -vE '(speed_(trades|pool_ledger)_[0-9]{8})' /tmp/drift.sql > /tmp/drift-filtered.sql || true
          sed -i '/^[[:space:]]*$/d' /tmp/drift-filtered.sql
          if [ -s /tmp/drift-filtered.sql ]; then
            echo "::warning::Schema drift detected (snapshot is stale):"
            cat /tmp/drift-filtered.sql
            echo "::warning::Regenerate locally and recommit: npx supabase db dump --linked --schema public --data-only=false > supabase/schema.sql"
          else
            echo "Schema matches snapshot — no drift (partition noise filtered)."
          fi
        env:
          SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN }}
          SUPABASE_DB_PASSWORD: ${{ secrets.SUPABASE_DB_PASSWORD }}

  smoke-test:
    name: Smoke Tests (money path)
    needs: migrate
    runs-on: ubuntu-latest
    environment: staging
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm
      - run: npm ci

      - name: Run smoke suite
        # Money-path subset: trade execution, resolution, commissions,
        # payout invariants, deposits/withdrawals. ~3-4 min total.
        # Full 301-test suite runs nightly + on PR to main.
        run: |
          npx vitest run \
            src/tests/format-utils.test.ts \
            src/tests/db/place-bet.test.ts \
            src/tests/db/resolve-market.test.ts \
            src/tests/db/commission.test.ts \
            src/tests/db/commission-branch.test.ts \
            src/tests/db/payout-invariants.test.ts \
            src/tests/db/deposit-withdrawal.test.ts
        env:
          SUPABASE_TEST_URL: ${{ secrets.SUPABASE_TEST_URL }}
          NEXT_PUBLIC_SUPABASE_URL: ${{ secrets.NEXT_PUBLIC_SUPABASE_URL }}
          SUPABASE_SERVICE_ROLE_KEY: ${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}
          NEXT_PUBLIC_SUPABASE_ANON_KEY: ${{ secrets.NEXT_PUBLIC_SUPABASE_ANON_KEY }}

  # Vercel auto-deploys via GitHub integration — no workflow step needed.

  health-check:
    name: Post-Deploy Health Check
    needs: smoke-test
    runs-on: ubuntu-latest
    steps:
      - name: Wait for Vercel deploy
        run: sleep 120

      - name: Check staging health
        run: |
          STATUS=$(curl -s -o /dev/null -w "%{http_code}" "${{ vars.STAGING_URL }}/api/health")
          if [ "$STATUS" != "200" ]; then
            echo "::warning::Staging health check returned HTTP $STATUS"
            exit 1
          fi
          echo "Staging is healthy (HTTP 200)"

  notify-failure:
    name: Slack Failure Alert
    needs: [type-check, migrate, smoke-test, health-check]
    if: failure()
    runs-on: ubuntu-latest
    steps:
      - name: Notify Slack
        uses: slackapi/slack-github-action@v3.0.2
        with:
          webhook: ${{ secrets.SLACK_WEBHOOK_URL }}
          webhook-type: incoming-webhook
          # Drop the raw commit message body — multi-line bodies with
          # quotes/backticks break the slack-github-action YAML parser
          # and cause this step itself to fail (silent alert).
          payload: |
            {
              "text": ":red_circle: *Staging deploy FAILED* [STAGING]\nBranch: `${{ github.ref_name }}`\nCommit: `${{ github.sha }}`\nRun: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}"
            }
