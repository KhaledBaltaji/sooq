name: Staging Crons (weekly)

# Once a week, extend speed-markets partition tables by 14 days. Production
# Vercel runs this via vercel.json. Staging Preview can't, so we mirror it
# here. Requires repo secrets: STAGING_CRON_SECRET; repo variables: STAGING_URL.

on:
  schedule:
    - cron: "0 0 * * 0" # Sunday 00:00 UTC
  workflow_dispatch:

concurrency:
  group: staging-crons-weekly
  cancel-in-progress: false

jobs:
  partitions:
    name: Extend speed partitions
    runs-on: ubuntu-latest
    timeout-minutes: 2
    steps:
      - name: speed-partitions
        run: |
          curl -fsS --max-time 30 \
            -H "Authorization: Bearer ${{ secrets.STAGING_CRON_SECRET }}" \
            "${{ vars.STAGING_URL }}/api/cron/speed-partitions" \
            -o /tmp/r.json -w "status=%{http_code}\n"
          cat /tmp/r.json | head -c 400; echo
