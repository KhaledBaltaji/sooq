name: Deploy Production

on:
  push:
    branches: [main]

concurrency:
  group: deploy-production
  cancel-in-progress: false

jobs:
  test:
    name: Run Tests
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Type check
        run: npx tsc --noEmit

      - name: Run unit tests (non-DB)
        run: npx vitest run src/tests/format-utils.test.ts

  migrate:
    name: Apply Migrations
    runs-on: ubuntu-latest
    needs: test
    environment: production  # Requires manual approval (configure in GitHub Settings > Environments)
    steps:
      - uses: actions/checkout@v4

      - uses: supabase/setup-cli@v2
        with:
          version: latest

      - name: Link Supabase project
        run: supabase link --project-ref ${{ secrets.SUPABASE_PROJECT_REF }}
        env:
          SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN }}

      - name: Push migrations
        # SUPABASE_DB_PASSWORD required — without it the CLI falls back to
        # the access-token "Initialising login role…" bootstrap which
        # times out and silently aborts the push.
        run: supabase db push
        env:
          SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN }}
          SUPABASE_DB_PASSWORD: ${{ secrets.SUPABASE_DB_PASSWORD }}

  health-check:
    name: Health Check
    runs-on: ubuntu-latest
    needs: migrate
    steps:
      - name: Wait for Vercel deploy
        run: sleep 120

      - name: Check production health
        run: |
          STATUS=$(curl -s -o /dev/null -w "%{http_code}" "${{ vars.PRODUCTION_URL }}/api/health")
          if [ "$STATUS" != "200" ]; then
            echo "Health check failed: HTTP $STATUS"
            exit 1
          fi
          echo "Production is healthy (HTTP 200)"

  notify-failure:
    name: Slack Failure Alert
    needs: [migrate, health-check]
    if: failure()
    runs-on: ubuntu-latest
    steps:
      - name: Notify Slack
        uses: slackapi/slack-github-action@v3.0.2
        with:
          webhook: ${{ secrets.SLACK_WEBHOOK_URL }}
          webhook-type: incoming-webhook
          # Drop the raw commit message body — multi-line bodies with
          # quotes/backticks break the slack-github-action YAML/JSON
          # parser and cause this step itself to fail (silent alert).
          payload: |
            {
              "text": ":red_circle: *Production deploy FAILED* [PRODUCTION]\nBranch: `${{ github.ref_name }}`\nCommit: `${{ github.sha }}`\nRun: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}"
            }
