# Required — full Postgres connection string for RDS staging.
# Pull from AWS Secrets Manager (rds!db-fc910551-...) and substitute the
# password into the URL. The worker strips ?sslmode=require client-side
# and re-enables SSL with rejectUnauthorized:false (matches the Next app).
DATABASE_URL=postgresql://sooqadmin:<password>@sooq-staging-db.cl0keqcqsenr.eu-central-1.rds.amazonaws.com:5432/sooq

# Optional
PORT=3000
SENTRY_DSN=
NODE_ENV=production
