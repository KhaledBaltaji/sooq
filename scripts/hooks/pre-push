#!/bin/bash
# Pre-push hook: block direct pushes to an *existing* main branch.
# Allows the first push that creates main on the remote (remote_sha is zero).
# Smoke suite removed in W1 — most of those test files (LMSR, commission)
# are scheduled for deletion in W2/W3. Will be re-added with a leaner
# speed-only smoke set in W4+.
export PATH="/usr/local/bin:/opt/homebrew/bin:$PATH"

ZERO_SHA="0000000000000000000000000000000000000000"

while read local_ref local_sha remote_ref remote_sha; do
  branch=$(echo "$remote_ref" | sed 's|refs/heads/||')

  # First push that creates the branch on the remote — let it through.
  if [ "$remote_sha" = "$ZERO_SHA" ]; then
    continue
  fi

  if [ "$branch" = "main" ]; then
    echo "BLOCKED: Direct push to existing main is forbidden."
    echo "Open a PR from a feature branch into main instead."
    exit 1
  fi
done
