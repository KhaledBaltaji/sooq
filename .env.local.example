# ─── Supabase ───────────────────────────────────────────────────────────────
# Each environment (staging/demo/production) has its own Supabase project.
# Get these from: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── App URL ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Payment Providers ──────────────────────────────────────────────────────
THREEPAY_API_KEY=
THREEPAY_API_SECRET=
THREEPAY_BASE_URL=https://sandbox.pay.3pa-y.com/api/v1
THREEPAY_WEBHOOK_SECRET=
WHISH_WEBHOOK_SECRET=
WHISH_API_KEY=

# ─── Support (WhatsApp deep link) ──────────────────────────────────────────
# Phone number that the in-app "Contact Support" button opens a chat with.
# Format: international, digits-only or +-prefixed (non-digit chars are stripped).
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# ─── Sentry (Error Monitoring) ────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─── Cron Jobs ──────────────────────────────────────────────────────────────
CRON_SECRET=

# ─── Slack Alerts ───────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ─── GitHub Actions (set as GitHub Secrets, not here) ───────────────────────
# SUPABASE_ACCESS_TOKEN    — Personal token from supabase.com/dashboard/account/tokens
# SUPABASE_PROJECT_REF     — Project ref per environment (e.g. zzebptrztuwnqlxxmjuo)
# SUPABASE_DB_PASSWORD     — Database password (for demo SQL apply via psql)
# SUPABASE_DB_URL          — Direct DB connection string (for demo deploy)
# PRODUCTION_URL           — Production URL for health checks
